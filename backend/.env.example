# ==============================================================================
# SkyFlow Aviation & Flight Management System — Environment Configuration (.env)
# ==============================================================================

# Database Connection URL (PostgreSQL / Neon DB / SQLite)
# Example PostgreSQL URL:
DATABASE_URL=postgresql+asyncpg://user:password@ep-host.aws.neon.tech/neondb?sslmode=require
# Or for local SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./flight_system.db

# Application Security & JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="Flight Management System API"
API_V1_STR=/api/v1
CORS_ORIGINS=["*"]

# Booking & Reservation Hold Settings
PRICE_HOLD_EXPIRE_MINUTES=15
SEAT_HOLD_EXPIRE_MINUTES=10
DEFAULT_OVERBOOKING_POLICY=HARD_LIMIT

# Initial Super Admin Seed Credentials
FIRST_SUPERADMIN_EMAIL=admin@gmail.com
FIRST_SUPERADMIN_PASSWORD=your_admin_secure_password

# Email / SMTP Configuration (Gmail SMTP or SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Groq LLM API Key (For Floating AI RAG Policy Assistant)
GROQ_API_KEY=gsk_your_groq_api_key_here
